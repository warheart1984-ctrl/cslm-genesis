# Local Ollama is the default drafter. Weights live on the 4TB drive.
CSLM_ADAPTER=openai_compat
CSLM_BASE_LM_BASE_URL=http://127.0.0.1:11435
CSLM_BASE_LM_MODEL=llama3.2:3b
CSLM_BASE_LM_TIMEOUT=300
# CSLM_BASE_LM_API_KEY=

# Project-local Ollama (11434 is the system daemon; it writes to the full OS disk)
OLLAMA_MODELS=/media/jon/DEEA8E6FEA8E442D/ollama-models
OLLAMA_HOST=127.0.0.1:11435

PORT=8080
